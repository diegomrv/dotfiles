shell-integration-features = ssh-terminfo,no-cursor
keybind = shift+enter=text:\x1b\r
#theme = Catppuccin Frappe
# Fallback theme. Overridden by the auto theme file below when it exists.
theme = Hopscotch.256
# Written by `ghostty +list-themes` when you press `w` on a theme.
# Pick a theme there, press w, then cmd+shift+, in Ghostty to reload.
config-file = ?~/Library/Application Support/com.mitchellh.ghostty/auto/theme.ghostty
background-opacity = 0.95
background-blur-radius = 40
window-height = 90
window-width = 160
window-padding-x = 8
window-padding-y = 8
cursor-style = block
window-save-state = always
auto-update-channel = tip
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = true
