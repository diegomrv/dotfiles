.idea
.DS_Store
._*
.uuid
.Trash-*

# Machine-specific config, never tracked
.zshrc.local
.gitconfig.local
.claude/settings.local.json

*.log
*.sock

# Runtime state apps write inside the ~/.config/<app> folders that stow links
# whole into a package (only the config files themselves are tracked)
shell/.config/herdr/*
!shell/.config/herdr/config.toml
dev/.config/opencode/*
!dev/.config/opencode/opencode.jsonc
dev/.config/zed/prompts/
macos/.config/codexbar/*.lock

# Claude Code's claude.ai skill sync, and skills installed by `npx skills` (symlinks, per machine)
claude/.claude/skills/synced/
