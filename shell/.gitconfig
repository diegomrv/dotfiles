# This is Git's per-user configuration file.
[user]
name = Diego Rodríguez
email = diego@strangepixels.co
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[init]
	defaultBranch = main
[include]
	path = ~/.gitconfig.local
# Resolve gh from PATH -- it lives at /opt/homebrew/bin on the Macs and
# /home/linuxbrew/.linuxbrew/bin on kraken.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
