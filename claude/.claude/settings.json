{
  "permissions": {
    "allow": [
      "Bash(git checkout:*)",
      "Bash(compaudit:*)",
      "Bash(nvim:*)",
      "Bash(bash /Users/drodriguez/mainframe/.claude/skills/git-sync-check/git-sync-check.sh*)"
    ],
    "deny": [
      "Skill(superpowers:requesting-code-review)",
      "Skill(superpowers:receiving-code-review)",
      "Skill(superpowers:using-git-worktrees)",
      "Skill(superpowers:writing-skills)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "tldraw-offline",
        "hooks": [
          {
            "type": "command",
            "command": "s=\"$HOME/skills/tldraw-offline/inject-server-context.sh\"; [ -f \"$s\" ] && sh \"$s\" SubagentStart || true"
          }
        ]
      }
    ]
  },
  "enableWorkflows": false,
  "statusLine": {
    "type": "command",
    "command": "command -v npx >/dev/null && npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "skill-creator@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "typesafe@typesafe-ai": true,
    "linear@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "webflow-skills": {
      "source": {
        "source": "github",
        "repo": "webflow/webflow-skills"
      },
      "autoUpdate": true
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      },
      "autoUpdate": true
    }
  },
  "sandbox": {
    "excludedCommands": [
      "agent-browser *"
    ]
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "advisorModel": "fable",
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(*claude-in-chrome*) — CLAUDE.md restricts use to explicit request for Diego's live Chrome session"
    ],
    "environment": [
      "$defaults",
      "**Org-specific CLIs**: agent-browser (required for all browser automation/visual checks per CLAUDE.md; do not use claude-in-chrome MCP tools unless Diego explicitly asks for his real Chrome session)"
    ]
  },
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754321351818
  }
}
